# Shared configuration for the R1 cloud run. Sourced by bench.sh and train.sh.
# Every variable can be overridden from the environment, e.g. `BUCKETS=50 ./train.sh`.
#
# R1 is defined in ~/Downloads/gpo-research/PLAN.md section 5.2: medium betting
# tree, 169 / 200 / 200 / 200 buckets (preflop / flop / turn / river), 200 BB
# stacks. 200 BB = 20,000 chips with the trainer's 50/100 blinds (blueprint/README.md,
# "Betting tree"). On the pre-M0 tree `bp tree` with these flags printed 81,406,148
# infosets and 2,621.1 MB of training tables (PLAN.md's 81.4M and 2.6 GB). After M0
# (all-in legal at capped nodes, swarm/next 368b379) it prints 85,778,056 infosets
# and 2,778.5 MB; `bp scale tree` prints 946.4 MB for the compact layout.

: "${PRESET:=medium}"
: "${STACK:=20000}"
: "${BUCKETS:=200}"
: "${BINS:=50}"
: "${ABS_SEED:=7}"

# Target visits per infoset. PLAN.md 5.1: "about 160,000 visits per infoset reached
# the quality of the 25-minute small run" (crude rule from blueprint/README.md).
# The M6 gate needs learning-curve points past 160,000, so consider 240000 there.
: "${VISITS_PER_INFOSET:=160000}"

# Pruning constants in chips. Pluribus used -300,000,000 / -310,000,000
# (gpo-research/pluribus.md, table in section 2). The 25-minute run, which reached
# the same ~160,000 visits per infoset, used 10x smaller values because the Pluribus
# threshold "would rarely trigger in a run this short" (blueprint/README.md).
: "${PRUNE_THRESHOLD:=-30000000}"
: "${REGRET_FLOOR:=-31000000}"

# Pluribus schedule shape (pluribus.md section 2): Linear CFR for the first 400
# minutes, one discount every 10 minutes (so 40 discounts), pruning from minute
# 200, out of an 8-day run (8 x 24 x 60 = 11,520 minutes). Scaled to the run
# length these are fractions of the total iteration count.
: "${LCFR_FRAC:=0.034722}"     # 400 / 11520
: "${PRUNE_FRAC:=0.017361}"    # 200 / 11520
: "${NUM_DISCOUNTS:=40}"       # 400 / 10

: "${CKPT_EVERY_MIN:=15}"
: "${SNAPSHOTS_PER_RUN:=8}"    # learning-curve points for PLAN.md's M6 gate

tree_flags() {
  echo "--preset $PRESET --stack $STACK --flop $BUCKETS --turn $BUCKETS --river $BUCKETS --bins $BINS --abs-seed $ABS_SEED"
}

ncores() {
  if command -v nproc >/dev/null 2>&1; then nproc; else sysctl -n hw.ncpu; fi
}
